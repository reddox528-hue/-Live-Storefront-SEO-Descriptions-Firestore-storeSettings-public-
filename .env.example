# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (used for email links, sitemap, canonical URLs, etc.).
APP_URL="MY_APP_URL"

# BREVO SERVER-SIDE EMAIL CONFIGURATION (Never expose BREVO_API_KEY in frontend or VITE_* vars)
# Store BREVO_API_KEY in Firebase Secret Manager: `firebase functions:secrets:set BREVO_API_KEY`
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="KoraMarket Nigeria"
ADMIN_NOTIFICATION_EMAIL=""

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional JSON string of Firebase Admin service account
# for running trusted server-side Express admin routes & Cloud Functions parity locally.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# VITE_USE_CLOUD_FUNCTIONS: Set to "true" once Firebase Cloud Functions are deployed to route
# order creation and payment verification through HTTPS Callable Cloud Functions.
VITE_USE_CLOUD_FUNCTIONS="false"
